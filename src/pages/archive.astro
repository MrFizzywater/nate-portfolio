---
import { getCollection, render } from 'astro:content';
import '../styles/global.css';

const rawVideos = await getCollection('archive');
const videos = await Promise.all(
  rawVideos.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<!DOCTYPE html>
<html lang="en" class="bg-stone-950 text-stone-100 antialiased selection:bg-stone-800">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Moving Image Archive — Nate Lacroix</title>
</head>
<body class="min-h-screen flex flex-col justify-between font-sans">

  <header class="border-b border-stone-800/80 sticky top-0 bg-stone-950/90 backdrop-blur-md z-20">
    <div class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between">
      <div>
        <a href="/" class="text-xl font-light tracking-tight text-white block">Nate Lacroix</a>
        <span class="text-[10px] uppercase tracking-[0.25em] text-stone-500">Directing &amp; Editorial Archive</span>
      </div>
      <nav class="flex items-center gap-6 text-xs uppercase tracking-widest font-medium">
        <a href="/" class="text-stone-400 hover:text-white transition-colors">&larr; Photographic Editions</a>
        <a href="/archive/" class="text-white border-b border-white pb-0.5">Moving Image</a>
      </nav>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-16 flex-grow w-full">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-light tracking-tight text-white">Selected Motion Work</h1>
      <p class="text-stone-400 text-sm mt-2 max-w-xl font-light">
        A catalog of past music videos, short-form documentaries, and editorial sequences.
      </p>
    </div>

    <div class="divide-y divide-stone-900 border-t border-b border-stone-900">
      {videos.map(({ data, Content }) => (
        <article class="py-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
          <div class="aspect-video bg-stone-900 border border-stone-800 overflow-hidden relative">
            <img 
              src={data.coverImage} 
              alt={data.title} 
              class="w-full h-full object-cover" 
              loading="lazy" 
            />
          </div>

          <div class="md:col-span-2 space-y-3">
            <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-widest text-stone-500">
              <span>{data.category}</span>
              <span>&bull;</span>
              <span>{data.year}</span>
              {data.client && (
                <>
                  <span>&bull;</span>
                  <span class="text-stone-400">{data.client}</span>
                </>
              )}
            </div>

            <h2 class="text-2xl font-light text-white tracking-tight">{data.title}</h2>
            <p class="text-xs uppercase tracking-wider text-stone-400">Role: {data.role}</p>

            <div class="text-stone-300 text-sm font-light leading-relaxed prose prose-invert">
              <Content />
            </div>

            {data.videoUrl && (
              <div class="pt-2">
                <a 
                  href={data.videoUrl} 
                  target="_blank" 
                  rel="noopener noreferrer"
                  class="inline-block text-xs uppercase tracking-[0.2em] border border-stone-700 hover:border-white text-stone-200 hover:text-white px-4 py-2 transition-colors"
                >
                  Watch Reel / Video &rarr;
                </a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </main>

  <footer class="border-t border-stone-900 py-8 text-center text-[10px] uppercase tracking-widest text-stone-600">
    &copy; 2026 Nate Lacroix. All rights reserved.
  </footer>
</body>
</html>
