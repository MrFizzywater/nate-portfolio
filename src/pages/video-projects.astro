---
import { getCollection, render } from 'astro:content';
import settings from '../content/settings/general.json';
import '../styles/global.css';

const rawVideos = await getCollection('archive');
const videos = await Promise.all(
  rawVideos.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);

function getEmbedUrl(url: string = '') {
  if (!url) return null;
  const ytMatch = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
  if (ytMatch) {
    return { type: 'iframe', src: `https://www.youtube.com/embed/${ytMatch[1]}?autoplay=1&rel=0` };
  }
  if (url.includes('iframe.mediadelivery.net')) {
    const cleanUrl = url.replace(/([?&])autoplay=(true|1|false|0)(&|$)/, '$1').replace(/[?&]$/, '');
    const separator = cleanUrl.includes('?') ? '&' : '?';
    return { type: 'iframe', src: `${cleanUrl}${separator}autoplay=true` };
  }
  if (url.endsWith('.mp4') || url.endsWith('.webm')) {
    return { type: 'video', src: url };
  }
  return { type: 'iframe', src: url };
}
---

<!DOCTYPE html>
<html lang="en" class="bg-stone-950 text-stone-100 antialiased selection:bg-stone-800">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Video Projects — {settings.siteTitle || "Nate Lacroix"}</title>
</head>
<body class="min-h-screen flex flex-col justify-between font-sans">

  <header class="border-b border-stone-800/80 sticky top-0 bg-stone-950/90 backdrop-blur-md z-30">
    <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <a href="/" class="text-xl font-light tracking-tight text-white block">
          {settings.siteTitle || "Nate Lacroix"}
        </a>
        <span class="text-[10px] uppercase tracking-[0.25em] text-stone-500">
          Directing &amp; Editorial Archive
        </span>
      </div>
      <nav class="flex items-center gap-5 sm:gap-6 text-xs uppercase tracking-widest font-medium">
        <a href="/" class="text-stone-400 hover:text-white transition-colors">Work</a>
        <a href="/galleries/" class="text-stone-400 hover:text-white transition-colors">Galleries</a>
        <a href="/video-projects/" class="text-white border-b border-white pb-0.5">Video Projects</a>
        <a href="/about/" class="text-stone-400 hover:text-white transition-colors">About</a>
        <a href="/contact/" class="text-stone-400 hover:text-white transition-colors">Contact</a>
      </nav>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-6 py-16 flex-grow w-full">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-light tracking-tight text-white">Video Projects</h1>
      <p class="text-stone-400 text-sm mt-2 max-w-xl font-light">
        A catalog of past music videos, short-form documentaries, and editorial sequences.
      </p>
    </div>

    {videos.length === 0 ? (
      <div class="py-24 text-center">
        <p class="text-stone-500 text-sm font-mono">[ARCHIVE] No video projects published yet.</p>
      </div>
    ) : (
      <div class="divide-y divide-stone-900 border-t border-b border-stone-900">
        {videos.map(({ data, id, Content }) => {
          const embed = getEmbedUrl(data.videoUrl);
          const modalId = `video-modal-${id}`;
          return (
            <article class="py-10 grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
              <button
                type="button"
                class="aspect-video bg-stone-900 border border-stone-800 overflow-hidden relative group text-left cursor-pointer w-full block"
                data-open-modal={modalId}
              >
                <img 
                  src={data.coverImage} 
                  alt={data.title} 
                  class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
                  loading="lazy" 
                />
                <div class="absolute inset-0 bg-stone-950/40 group-hover:bg-stone-950/20 transition-colors flex items-center justify-center">
                  <div class="w-12 h-12 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center group-hover:scale-110 transition-transform">
                    <span class="text-white text-xs pl-0.5">&#9658;</span>
                  </div>
                </div>
              </button>

              <div class="md:col-span-2 space-y-3">
                <div class="flex items-center gap-3 text-[11px] font-mono uppercase tracking-widest text-stone-500">
                  <span>{data.category}</span>
                  <span>&bull;</span>
                  <span>{data.year}</span>
                  {data.client && (
                    <>
                      <span>&bull;</span>
                      <span class="text-stone-400">{data.client}</span>
                    </>
                  )}
                </div>

                <h2 class="text-2xl font-light text-white tracking-tight">{data.title}</h2>
                <p class="text-xs uppercase tracking-wider text-stone-400">Role: {data.role}</p>

                <div class="text-stone-300 text-sm font-light leading-relaxed prose prose-invert">
                  <Content />
                </div>

                <div class="pt-2">
                  <button 
                    type="button"
                    class="inline-block text-xs uppercase tracking-[0.2em] border border-stone-700 hover:border-white text-stone-200 hover:text-white px-4 py-2 transition-colors cursor-pointer"
                    data-open-modal={modalId}
                  >
                    Watch Reel / Video &rarr;
                  </button>
                </div>
              </div>

              <!-- Lightbox Modal -->
              <dialog 
                id={modalId} 
                class="m-auto p-0 rounded-xs backdrop:bg-stone-950/90 bg-stone-900 text-stone-100 max-w-5xl w-[94vw] max-h-[92vh] overflow-hidden shadow-2xl border border-stone-800"
                data-video-dialog
              >
                <div class="relative bg-black flex flex-col">
                  <div class="flex items-center justify-between p-4 bg-stone-950 border-b border-stone-850">
                    <span class="text-xs uppercase tracking-widest text-stone-400 truncate pr-4">{data.title}</span>
                    <button 
                      type="button"
                      class="text-stone-400 hover:text-white text-2xl font-light leading-none cursor-pointer px-2"
                      onclick={`document.getElementById('${modalId}').close()`}
                      aria-label="Close"
                    >
                      &times;
                    </button>
                  </div>

                  <div class="aspect-video w-full bg-black flex items-center justify-center">
                    {embed?.type === 'iframe' && (
                      <iframe 
                        data-src={embed.src} 
                        title={data.title}
                        class="w-full h-full border-0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                        allowfullscreen
                      ></iframe>
                    )}
                    {embed?.type === 'video' && (
                      <video controls class="w-full h-full object-contain">
                        <source data-src={embed.src} type="video/mp4" />
                      </video>
                    )}
                    {!embed && (
                      <p class="text-stone-500 text-xs font-mono">No video link provided for this entry.</p>
                    )}
                  </div>
                </div>
              </dialog>
            </article>
          );
        })}
      </div>
    )}
  </main>

  <footer class="border-t border-stone-900 py-8 text-center text-[10px] uppercase tracking-widest text-stone-600">
    &copy; 2026 {settings.siteTitle || "Nate Lacroix"}. All rights reserved.
  </footer>

  <script>
    // Dynamic open handlers (inject src on click only)
    document.querySelectorAll('[data-open-modal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const modalId = btn.getAttribute('data-open-modal');
        if (!modalId) return;
        const dialog = document.getElementById(modalId) as HTMLDialogElement | null;
        if (!dialog) return;

        const iframe = dialog.querySelector('iframe');
        if (iframe && iframe.dataset.src) {
          iframe.src = iframe.dataset.src;
        }

        const video = dialog.querySelector('video');
        const source = video?.querySelector('source');
        if (video && source && source.dataset.src) {
          source.src = source.dataset.src;
          video.load();
          video.play();
        }

        dialog.showModal();
      });
    });

    // Teardown and pause on modal close
    document.querySelectorAll('[data-video-dialog]').forEach((dialog) => {
      dialog.addEventListener('close', () => {
        const iframe = dialog.querySelector('iframe');
        if (iframe) {
          iframe.removeAttribute('src'); // Unload immediately
        }
        const video = dialog.querySelector('video');
        if (video) {
          video.pause();
          video.currentTime = 0;
        }
      });

      dialog.addEventListener('click', (event) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          (dialog as HTMLDialogElement).close();
        }
      });
    });
  </script>
</body>
</html>
