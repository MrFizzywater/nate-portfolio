---
import { getCollection, render } from 'astro:content';
import settings from '../content/settings/general.json';
import '../styles/global.css';

const rawPhotos = await getCollection('photos');
const photos = await Promise.all(
  rawPhotos.map(async (item) => {
    const { Content } = await render(item);
    return { ...item, Content };
  })
);
---

<!DOCTYPE html>
<html lang="en" class="bg-stone-950 text-stone-100 antialiased selection:bg-stone-800">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{settings.siteTitle} — {settings.tagline}</title>
</head>
<body class="min-h-screen flex flex-col justify-between font-sans">

  <!-- Header (CMS Driven) -->
  <header class="border-b border-stone-800/80 sticky top-0 bg-stone-950/90 backdrop-blur-md z-30">
    <div class="max-w-6xl mx-auto px-6 py-6 flex items-center justify-between">
      <div>
        <a href="/" class="text-xl font-light tracking-tight text-white block">
          {settings.logo ? (
            <img src={settings.logo} alt={settings.siteTitle} class="h-8 w-auto object-contain" />
          ) : (
            settings.siteTitle || "Nate Lacroix"
          )}
        </a>
        <span class="text-[10px] uppercase tracking-[0.25em] text-stone-500">
          {settings.tagline || "Photography • Moving Image"}
        </span>
      </div>
      <nav class="flex items-center gap-6 text-xs uppercase tracking-widest font-medium">
        <a href="/" class="text-white border-b border-white pb-0.5">Work</a>
        <a href="/about/" class="text-stone-400 hover:text-white transition-colors">About</a>
        <a href="/contact/" class="text-stone-400 hover:text-white transition-colors">Contact</a>
      </nav>
    </div>
  </header>

  <!-- Masonry Photo Grid -->
  <main class="max-w-6xl mx-auto px-6 py-12 flex-grow w-full">
    <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
      {photos.map(({ data, id }) => (
        <article class="break-inside-avoid group flex flex-col bg-stone-900/40 border border-stone-800/70 p-2 overflow-hidden">
          <button
            type="button"
            class="relative overflow-hidden cursor-zoom-in block w-full text-left"
            onclick={`document.getElementById('modal-${id}').showModal()`}
          >
            <img 
              src={data.image} 
              alt={data.title}
              class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-stone-950/25 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <span class="text-[10px] uppercase tracking-widest bg-stone-950/80 text-white px-3 py-1.5 border border-stone-700">Enlarge</span>
            </div>
          </button>
          
          <div class="p-3 flex justify-between items-baseline">
            <h2 class="text-sm font-light text-stone-200">{data.title}</h2>
            <span class="text-[10px] font-mono uppercase text-stone-500">{data.category}</span>
          </div>
        </article>
      ))}
    </div>
  </main>

  <!-- Lightbox Modals -->
  {photos.map(({ data, id, Content }) => (
    <dialog 
      id={`modal-${id}`} 
      class="m-auto p-0 rounded-xs backdrop:bg-stone-950/85 bg-stone-900 text-stone-100 max-w-4xl w-[94vw] max-h-[92vh] overflow-y-auto shadow-2xl border border-stone-800"
      onclick="if (event.target === this) this.close()"
    >
      <div class="p-6 sm:p-8 relative">
        <button 
          type="button"
          class="absolute top-4 right-4 text-stone-400 hover:text-white text-3xl font-light cursor-pointer leading-none p-2 z-10"
          onclick={`document.getElementById('modal-${id}').close()`}
        >
          &times;
        </button>
        <div class="bg-black/40 flex items-center justify-center max-h-[70vh] overflow-hidden mb-6">
          <img src={data.image} alt={data.title} class="max-h-[70vh] w-auto mx-auto object-contain" />
        </div>
        <div class="border-t border-stone-800 pt-4 flex flex-col sm:flex-row justify-between items-start gap-4">
          <div>
            <h3 class="text-2xl font-light text-white">{data.title}</h3>
            <span class="text-xs uppercase tracking-widest text-stone-500 font-mono">{data.category} &bull; {data.year}</span>
          </div>
          <div class="text-sm font-light text-stone-300 prose prose-invert prose-sm">
            <Content />
          </div>
        </div>
      </div>
    </dialog>
  ))}

  <!-- Footer -->
  <footer class="border-t border-stone-900 py-8 text-center text-[10px] uppercase tracking-widest text-stone-600">
    &copy; 2026 {settings.siteTitle || "Nate Lacroix"}. All rights reserved.
  </footer>
</body>
</html>
