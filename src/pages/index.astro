---
import { getCollection, getEntry } from 'astro:content';
import { getBunnyGalleries } from '../lib/bunny';
import settings from '../content/settings/general.json';
import '../styles/global.css';

// 1. Fetch Bunny Collections & Pick Exactly ONE Random Image per Gallery
const collections = await getBunnyGalleries();

const singleRandomFromEachGallery = collections
  .map((col) => {
    if (!col.images || col.images.length === 0) return null;
    const randomImg = col.images[Math.floor(Math.random() * col.images.length)];
    return {
      ...randomImg,
      collectionTitle: col.title,
      collectionFolder: col.folder,
    };
  })
  .filter((item): item is NonNullable<typeof item> => item !== null)
  .sort(() => 0.5 - Math.random()); // Shuffle gallery order

// 2. Fetch About Entry
const aboutEntry = await getEntry('pages', 'about');
const bioSnippet = aboutEntry?.data.headline || "Media artist, filmmaker, and photographer exploring atmospheric texture, pacing, and visual resonance.";

// 3. Fetch Random Video Project
const allVideos = await getCollection('archive');
const featuredVideo = allVideos.length > 0 
  ? allVideos[Math.floor(Math.random() * allVideos.length)] 
  : null;

function getEmbedUrl(url: string = '') {
  if (!url) return null;
  const ytMatch = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
  if (ytMatch) {
    return { type: 'iframe', src: `https://www.youtube.com/embed/${ytMatch[1]}?autoplay=1&rel=0` };
  }
  if (url.includes('iframe.mediadelivery.net')) {
    const cleanUrl = url.replace(/([?&])autoplay=(true|1|false|0)(&|$)/, '$1').replace(/[?&]$/, '');
    const separator = cleanUrl.includes('?') ? '&' : '?';
    return { type: 'iframe', src: `${cleanUrl}${separator}autoplay=true` };
  }
  if (url.endsWith('.mp4') || url.endsWith('.webm')) {
    return { type: 'video', src: url };
  }
  return { type: 'iframe', src: url };
}

const videoEmbed = featuredVideo ? getEmbedUrl(featuredVideo.data.videoUrl) : null;
---

<!DOCTYPE html>
<html lang="en" class="bg-stone-950 text-stone-100 antialiased selection:bg-stone-800">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{settings.siteTitle || "Nate Lacroix"} — {settings.tagline || "Media Artist"}</title>
</head>
<body class="min-h-screen flex flex-col justify-between font-sans selection:bg-stone-800">

  <!-- Header -->
  <header class="border-b border-stone-800/80 sticky top-0 bg-stone-950/90 backdrop-blur-md z-30">
    <div class="max-w-6xl mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <a href="/" class="text-xl font-light tracking-tight text-white block">
          {settings.logo ? (
            <img src={settings.logo} alt={settings.siteTitle} class="h-8 w-auto object-contain" />
          ) : (
            settings.siteTitle || "Nate Lacroix"
          )}
        </a>
        <span class="text-[10px] uppercase tracking-[0.25em] text-stone-500">
          {settings.tagline || "Photography • Moving Image"}
        </span>
      </div>
      <nav class="flex items-center gap-5 sm:gap-6 text-xs uppercase tracking-widest font-medium">
        <a href="/" class="text-white border-b border-white pb-0.5">Work</a>
        <a href="/galleries/" class="text-stone-400 hover:text-white transition-colors">Galleries</a>
        <a href="/video-projects/" class="text-stone-400 hover:text-white transition-colors">Video Projects</a>
        <a href="/about/" class="text-stone-400 hover:text-white transition-colors">About</a>
        <a href="/contact/" class="text-stone-400 hover:text-white transition-colors">Contact</a>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-8 flex-grow w-full space-y-12">

    <!-- UPPER STAGE: Context & Video Feature -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch pt-2">
      
      <!-- Left Column: Artist Context -->
      <div class="lg:col-span-5 flex flex-col justify-between bg-stone-900/30 border border-stone-800/80 p-6 sm:p-8">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-stone-500">Artist Focus</span>
            <span class="text-[10px] font-mono text-stone-600">44.75° N, 79.88° W</span>
          </div>

          <h1 class="text-2xl sm:text-3xl font-light tracking-tight text-white leading-snug">
            "{bioSnippet}"
          </h1>

          <p class="text-xs text-stone-400 font-light leading-relaxed pt-2">
            Independent media production, atmospheric photography archives, and directorial motion sequences based in Midland, Ontario.
          </p>
        </div>

        <div class="pt-6 mt-6 border-t border-stone-800/80 flex items-center justify-between text-xs font-mono">
          <a href="/about/" class="text-stone-300 hover:text-white uppercase tracking-widest text-[11px] transition-colors">
            Read Bio &rarr;
          </a>
          <a href="/contact/" class="text-stone-400 hover:text-stone-200 uppercase tracking-widest text-[11px] transition-colors">
            Inquiries &rarr;
          </a>
        </div>
      </div>

      <!-- Right Column: "Have you seen this one yet?" Video Card -->
      <div class="lg:col-span-7 bg-stone-900/30 border border-stone-800/80 p-6 sm:p-8 flex flex-col justify-between">
        {featuredVideo ? (
          <>
            <div class="flex items-center justify-between mb-4">
              <div class="inline-flex items-center gap-2 text-[10px] font-mono uppercase tracking-[0.2em] text-stone-400">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                <span>Have you seen this one yet?</span>
              </div>
              <a href="/video-projects/" class="text-[10px] font-mono uppercase tracking-widest text-stone-500 hover:text-stone-300">
                All Projects ({allVideos.length}) &rarr;
              </a>
            </div>

            <!-- Video Thumbnail Stage -->
            <button
              type="button"
              class="aspect-video w-full bg-stone-950 border border-stone-800 overflow-hidden relative group block cursor-pointer text-left"
              data-open-spotlight
            >
              <img 
                src={featuredVideo.data.coverImage} 
                alt={featuredVideo.data.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-stone-950/40 group-hover:bg-stone-950/20 transition-colors flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-stone-950/80 backdrop-blur-md border border-stone-700 flex items-center justify-center group-hover:scale-110 group-hover:border-white transition-all">
                  <span class="text-white text-xs pl-0.5">&#9658;</span>
                </div>
              </div>
            </button>

            <!-- Video Meta Footer -->
            <div class="mt-4 pt-3 border-t border-stone-800/80 flex items-center justify-between">
              <div>
                <h2 class="text-base font-light text-white tracking-tight">{featuredVideo.data.title}</h2>
                <span class="text-[10px] font-mono uppercase tracking-wider text-stone-500">
                  {featuredVideo.data.category} &bull; {featuredVideo.data.year} {featuredVideo.data.client ? `• ${featuredVideo.data.client}` : ''}
                </span>
              </div>
              <button 
                type="button" 
                class="text-[10px] uppercase font-mono tracking-widest border border-stone-700 px-3 py-1 text-stone-300 hover:text-white hover:border-stone-500 transition-colors cursor-pointer"
                data-open-spotlight
              >
                Watch Now
              </button>
            </div>
          </>
        ) : (
          <div class="h-full flex items-center justify-center py-12 text-stone-500 font-mono text-xs">
            No archive projects found. Add one in /admin/.
          </div>
        )}
      </div>

    </section>

    <!-- LOWER STAGE: Natural Masonry Gallery Sampling (1 Image Per Bunny Gallery) -->
    <section class="space-y-6 pt-4">
      <div class="flex items-baseline justify-between border-b border-stone-800/80 pb-3">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-stone-500 block">Cross-Gallery Sampler</span>
          <h2 class="text-xl font-light tracking-tight text-white">Atmospheric Frames</h2>
        </div>
        <div class="flex items-center gap-4">
          <button 
            type="button" 
            onclick="window.location.reload()" 
            class="text-[10px] font-mono uppercase tracking-widest text-stone-500 hover:text-stone-300 transition-colors cursor-pointer"
            title="Pick a new frame from each gallery"
          >
            [Re-Sample]
          </button>
          <a href="/galleries/" class="text-xs font-mono uppercase tracking-widest text-stone-400 hover:text-white transition-colors">
            All Galleries &rarr;
          </a>
        </div>
      </div>

      <!-- Natural Proportions Masonry -->
      {singleRandomFromEachGallery.length === 0 ? (
        <div class="py-16 text-center text-stone-600 font-mono text-xs">
          No gallery images available to sample. Upload folders to Bunny Storage under /galleries/.
        </div>
      ) : (
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
          {singleRandomFromEachGallery.map((img, idx) => {
            const modalId = `home-masonry-modal-${idx}`;
            return (
              <article class="break-inside-avoid bg-stone-900/40 border border-stone-800/80 p-2 group flex flex-col overflow-hidden">
                <button
                  type="button"
                  class="w-full bg-stone-950 overflow-hidden relative cursor-zoom-in block text-left"
                  onclick={`document.getElementById('${modalId}').showModal()`}
                >
                  <img 
                    src={img.url} 
                    alt={img.name}
                    class="w-full h-auto object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-stone-950/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                    <span class="text-[10px] uppercase tracking-widest bg-stone-950/80 text-white px-2.5 py-1 border border-stone-700">Enlarge</span>
                  </div>
                </button>

                <div class="pt-2.5 px-1 flex justify-between items-baseline">
                  <span class="text-xs font-mono text-stone-300 capitalize truncate pr-2">{img.name}</span>
                  <a 
                    href={`/galleries/${img.collectionFolder}/`}
                    class="text-[10px] font-mono uppercase tracking-wider text-stone-500 hover:text-stone-300 whitespace-nowrap transition-colors"
                  >
                    {img.collectionTitle} &rarr;
                  </a>
                </div>

                <!-- Lightbox Modal -->
                <dialog 
                  id={modalId}
                  class="m-auto p-0 rounded-xs backdrop:bg-stone-950/85 bg-stone-900 text-stone-100 max-w-5xl w-[94vw] max-h-[92vh] overflow-y-auto shadow-2xl border border-stone-800"
                >
                  <div class="p-6 sm:p-8 relative">
                    <button 
                      type="button"
                      class="absolute top-4 right-4 text-stone-400 hover:text-white text-3xl font-light cursor-pointer leading-none p-2 z-10"
                      onclick={`document.getElementById('${modalId}').close()`}
                      aria-label="Close"
                    >
                      &times;
                    </button>
                    <div class="bg-black/50 flex items-center justify-center max-h-[75vh] overflow-hidden mb-4">
                      <img src={img.url} alt={img.name} class="max-h-[75vh] w-auto mx-auto object-contain" />
                    </div>
                    <div class="border-t border-stone-800 pt-3 flex justify-between items-center text-xs font-mono text-stone-400">
                      <span class="capitalize text-stone-200">{img.name}</span>
                      <a href={`/galleries/${img.collectionFolder}/`} class="text-[10px] uppercase tracking-widest text-stone-500 hover:text-white">
                        Collection: {img.collectionTitle} &rarr;
                      </a>
                    </div>
                  </div>
                </dialog>
              </article>
            );
          })}
        </div>
      )}
    </section>

  </main>

  <!-- Video Modal Dialog -->
  {featuredVideo && (
    <dialog 
      id="spotlight-video-modal" 
      class="m-auto p-0 rounded-xs backdrop:bg-stone-950/90 bg-stone-900 text-stone-100 max-w-5xl w-[94vw] max-h-[92vh] overflow-hidden shadow-2xl border border-stone-800"
    >
      <div class="relative bg-black flex flex-col">
        <div class="flex items-center justify-between p-4 bg-stone-950 border-b border-stone-800">
          <span class="text-xs uppercase tracking-widest text-stone-400 truncate pr-4">
            {featuredVideo.data.title} ({featuredVideo.data.year})
          </span>
          <button 
            type="button"
            class="text-stone-400 hover:text-white text-2xl font-light leading-none cursor-pointer px-2"
            onclick="document.getElementById('spotlight-video-modal').close()"
            aria-label="Close"
          >
            &times;
          </button>
        </div>
        <div class="aspect-video w-full bg-black flex items-center justify-center">
          {videoEmbed?.type === 'iframe' && (
            <iframe 
              data-src={videoEmbed.src}
              title={featuredVideo.data.title}
              class="w-full h-full border-0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
              allowfullscreen
            ></iframe>
          )}
          {videoEmbed?.type === 'video' && (
            <video controls class="w-full h-full object-contain">
              <source data-src={videoEmbed.src} type="video/mp4" />
            </video>
          )}
          {!videoEmbed && (
            <p class="text-stone-500 text-xs font-mono">No video URL linked to this entry.</p>
          )}
        </div>
      </div>
    </dialog>
  )}

  <footer class="border-t border-stone-900 py-6 px-6 mt-12">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-[10px] font-mono text-stone-500 uppercase tracking-widest">
      <span>&copy; 2026 {settings.siteTitle || "Nate Lacroix"}. All rights reserved.</span>
      <span>Midland, Ontario &bull; Bunny Storage CDN</span>
    </div>
  </footer>

  <script>
    // Dialog outside click handlers
    document.querySelectorAll('dialog').forEach((dialog) => {
      dialog.addEventListener('click', (event) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= event.clientY &&
          event.clientY <= rect.top + rect.height &&
          rect.left <= event.clientX &&
          event.clientX <= rect.left + rect.width
        );
        if (!isInDialog) {
          (dialog as HTMLDialogElement).close();
        }
      });
    });

    const videoDialog = document.getElementById('spotlight-video-modal') as HTMLDialogElement | null;
    const iframe = videoDialog?.querySelector('iframe');
    const video = videoDialog?.querySelector('video');
    const videoSource = video?.querySelector('source');

    // On-demand spotlight video loader
    document.querySelectorAll('[data-open-spotlight]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!videoDialog) return;

        if (iframe && iframe.dataset.src) {
          iframe.src = iframe.dataset.src;
        }

        if (video && videoSource && videoSource.dataset.src) {
          videoSource.src = videoSource.dataset.src;
          video.load();
          video.play();
        }

        videoDialog.showModal();
      });
    });

    // Unload video cleanly on modal dismiss
    videoDialog?.addEventListener('close', () => {
      if (iframe) {
        iframe.removeAttribute('src');
      }
      if (video) {
        video.pause();
        video.currentTime = 0;
      }
    });
  </script>
</body>
</html>
