---
import { getBunnyGalleries } from '../../lib/bunny';
import settings from '../../content/settings/general.json';
import '../../styles/global.css';

const collections = await getBunnyGalleries();
---

<!DOCTYPE html>
<html lang="en" class="bg-stone-950 text-stone-100 antialiased selection:bg-stone-800">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Galleries — {settings.siteTitle || "Nate Lacroix"}</title>
</head>
<body class="min-h-screen flex flex-col justify-between font-sans">

  <header class="border-b border-stone-800/80 sticky top-0 bg-stone-950/90 backdrop-blur-md z-30">
    <div class="max-w-6xl mx-auto px-6 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <a href="/" class="text-xl font-light tracking-tight text-white block">
          {settings.siteTitle || "Nate Lacroix"}
        </a>
        <span class="text-[10px] uppercase tracking-[0.25em] text-stone-500">
          Photo Collections
        </span>
      </div>
      <nav class="flex items-center gap-5 sm:gap-6 text-xs uppercase tracking-widest font-medium">
        <a href="/" class="text-stone-400 hover:text-white transition-colors">Work</a>
        <a href="/galleries/" class="text-white border-b border-white pb-0.5">Galleries</a>
        <a href="/video-projects/" class="text-stone-400 hover:text-white transition-colors">Video Projects</a>
        <a href="/about/" class="text-stone-400 hover:text-white transition-colors">About</a>
        <a href="/contact/" class="text-stone-400 hover:text-white transition-colors">Contact</a>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-16 flex-grow w-full">
    <div class="mb-12">
      <h1 class="text-3xl sm:text-4xl font-light tracking-tight text-white">Galleries</h1>
      <p class="text-stone-400 text-sm mt-2 max-w-xl font-light">
        Curated location series and continuous photo archives stored on Bunny Storage.
      </p>
    </div>

    {collections.length === 0 ? (
      <div class="py-24 text-center">
        <p class="text-stone-500 text-sm font-mono">[BUNNY STORAGE] No gallery subfolders found in /galleries/.</p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {collections.map((col) => {
          // Select one random image from the collection for the cover
          const coverImg = col.images[Math.floor(Math.random() * col.images.length)] || col.images[0];
          return (
            <a 
              href={`/galleries/${col.folder}/`} 
              class="group flex flex-col bg-stone-900/40 border border-stone-800/80 p-3 hover:border-stone-600 transition-all duration-300"
            >
              <div class="aspect-4/3 bg-stone-950 overflow-hidden relative mb-4">
                {coverImg ? (
                  <img 
                    src={coverImg.url} 
                    alt={col.title}
                    class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-full h-full flex items-center justify-center text-stone-700 text-xs font-mono">Empty</div>
                )}
                <div class="absolute inset-0 bg-stone-950/20 group-hover:bg-transparent transition-colors"></div>
              </div>

              <div class="flex justify-between items-baseline pt-1">
                <h2 class="text-lg font-light text-stone-100 group-hover:text-white tracking-tight">
                  {col.title}
                </h2>
                <span class="text-[11px] font-mono text-stone-500">
                  {col.images.length} frames &rarr;
                </span>
              </div>
            </a>
          );
        })}
      </div>
    )}
  </main>

  <footer class="border-t border-stone-900 py-8 text-center text-[10px] uppercase tracking-widest text-stone-600">
    &copy; 2026 {settings.siteTitle || "Nate Lacroix"}. All rights reserved.
  </footer>
</body>
</html>
