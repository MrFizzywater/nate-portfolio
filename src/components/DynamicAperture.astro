---
interface PhotoItem {
  id: string;
  title: string;
  year: number;
  image: string;
  category: string;
  description?: string;
}

interface Props {
  photos: PhotoItem[];
}

const { photos } = Astro.props;
// Exclude 'posters' gallery items defensively from the randomized aperture engine
const sanitizedPhotos = (photos || []).filter((p) => {
  const cat = (p.category || '').toLowerCase().trim();
  const img = (p.image || '').toLowerCase();
  const id = (p.id || '').toLowerCase();
  return cat !== 'posters' && cat !== 'poster' && !img.includes('/posters/') && !id.startsWith('posters-');
});
// Client-side payload
const photosJson = JSON.stringify(sanitizedPhotos);
---

<div class="space-y-4" id="dynamic-aperture-container" data-photos={photosJson}>
  <!-- Section Title & Shutter Control Bar -->
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-zinc-800/80 pb-4">
    <div>
      <div class="flex items-center gap-3">
        <span class="w-2 h-2 bg-[#00ff88] rounded-none transform rotate-45 inline-block"></span>
        <span class="text-[11px] font-mono uppercase tracking-[0.25em] text-[#00ff88]">Dynamic Aperture</span>
        <span class="text-[10px] font-mono text-zinc-600">/</span>
        <span class="text-[10px] font-mono text-purple-400">Kinetic Gallery Shuffler</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-light tracking-tight text-white mt-1">
        Randomized Frame Engine
      </h2>
    </div>

    <!-- Angular Metallic Action Controls -->
    <div class="flex items-center gap-2.5 flex-wrap">
      <button 
        type="button" 
        id="btn-shuffle-frame"
        class="btn-steel chamfer-btn px-4 py-2 text-xs font-mono uppercase tracking-wider flex items-center gap-2 cursor-pointer border-zinc-700 hover:border-[#00ff88]"
        title="Load a new random frame from the gallery"
        data-flavor="SHUTTER CYCLE // Randomize active aperture frame and telemetry"
      >
        <svg class="w-3.5 h-3.5 text-[#00ff88]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Randomize Frame</span>
      </button>

      <button 
        type="button" 
        id="btn-toggle-cycle"
        class="bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/80 text-zinc-300 hover:text-white px-3.5 py-2 text-xs font-mono uppercase tracking-wider flex items-center gap-2 cursor-pointer transition-colors hover:border-purple-500"
        data-flavor="KINETIC MODE // Toggle 4-second automated gallery cycling"
      >
        <span class="w-1.5 h-1.5 bg-zinc-500 rounded-none" id="cycle-indicator-dot"></span>
        <span id="cycle-toggle-label">Auto-Cycle: Off</span>
      </button>

      <button 
        type="button" 
        id="btn-enlarge-aperture"
        class="bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/80 text-zinc-300 hover:text-white px-3 py-2 text-xs font-mono uppercase tracking-wider cursor-pointer transition-colors hover:border-purple-400"
        title="View full resolution"
        data-flavor="MAGNIFY // Open high-resolution frame inspection modal"
      >
        <span>Full View ↗</span>
      </button>
    </div>
  </div>

  <!-- Main Viewport & Curatorial Praise Chassis -->
  <div class="metallic-panel tech-corner border border-zinc-700/80 p-3 sm:p-5 relative overflow-hidden group">
    <!-- Angular Metallic Edge Sheen Line with Purple and Neon Green -->
    <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-purple-500/50 to-[#00ff88]/50 via-transparent pointer-events-none"></div>

    <!-- Cycle Progress Line (animates with Purple-to-Neon Green gradient when auto-cycle active) -->
    <div id="cycle-progress-bar" class="absolute top-0 left-0 h-[2px] bg-gradient-to-r from-purple-500 to-[#00ff88] w-0 transition-all duration-300 pointer-events-none"></div>

    <!-- 2-Column Split: Viewport on Left, Fictional Critical Praise on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
      
      <!-- Left Column: Primary Frame Viewport Stage (8 cols) -->
      <div class="lg:col-span-7 xl:col-span-8 flex flex-col justify-between">
        <!-- Viewport Container -->
        <div class="relative aspect-[16/10] sm:aspect-[16/9] w-full bg-black/95 border border-zinc-800/90 overflow-hidden flex items-center justify-center">
          <!-- Background Ambient Metallic Blur -->
