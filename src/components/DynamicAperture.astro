    },
    {
      quote: "My friend asked me if I wanted a frozen banana, and I said 'No, but I want a regular banana later, so yeah.'",
      author: "Mitch Hedberg",
      title: "Do You Believe in Gosh?",
      outlet: "Stand-Up Special"
    },
    {
      quote: "Rice is great if you're really hungry and want to eat two thousand of something.",
      author: "Mitch Hedberg",
      title: "Strategic Grill Locations",
      outlet: "Stand-Up Album"
    },

    // Taylor Tomlinson
    {
      quote: "Having your life together in your twenties is like having a nice apartment in a horror movie. You just know something terrible is about to crash through the window.",
      author: "Taylor Tomlinson",
      title: "Quarter-Life Crisis",
      outlet: "Netflix Comedy Special"
    },
    {
      quote: "Therapy is great because you pay someone a hundred dollars an hour to tell you, 'Yeah, your mom was definitely weird about that.'",
      author: "Taylor Tomlinson",
