            <div class="w-24 h-24 border border-white/20 relative">
              <div class="absolute top-1/2 left-0 right-0 h-[1px] bg-white/15"></div>
              <div class="absolute top-0 bottom-0 left-1/2 w-[1px] bg-white/15"></div>
              <div class="absolute top-0 left-0 w-2.5 h-2.5 border-t-2 border-l-2 border-[#00ff88]"></div>
              <div class="absolute top-0 right-0 w-2.5 h-2.5 border-t-2 border-r-2 border-[#00ff88]"></div>
              <div class="absolute bottom-0 left-0 w-2.5 h-2.5 border-b-2 border-l-2 border-[#c084fc]"></div>
              <div class="absolute bottom-0 right-0 w-2.5 h-2.5 border-b-2 border-r-2 border-[#c084fc]"></div>
            </div>
          </div>

          <!-- Live Aperture Shutter Wipe Overlay -->
          <div id="shutter-flash" class="absolute inset-0 bg-zinc-950/90 z-30 opacity-0 pointer-events-none transition-opacity duration-200"></div>
        </div>

        <!-- Metallic Telemetry & Metadata Strip -->
        <div class="mt-3 pt-3 border-t border-zinc-800/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 text-xs font-mono">
          <div class="flex items-center gap-2.5">
            <span class="text-white font-medium tracking-tight text-sm uppercase truncate max-w-[220px]" id="meta-title">Loading...</span>
            <span class="text-zinc-600">/</span>
            <span class="text-purple-400 tracking-wider uppercase text-[11px]" id="meta-category">Landscape</span>
          </div>

          <!-- Technical Telemetry Readout -->
          <div class="flex items-center gap-3 text-[11px] text-zinc-400 tabular-nums">
            <div class="flex items-center gap-1">
              <span class="text-zinc-600">YEAR:</span>
              <span class="text-zinc-300" id="meta-year">2026</span>
            </div>
            <span class="text-zinc-700">·</span>
            <div class="flex items-center gap-1">
              <span class="text-zinc-600">LENS:</span>
              <span class="text-zinc-300" id="meta-lens">35mm ƒ/2.8</span>
            </div>
            <span class="text-zinc-700">·</span>
            <div class="flex items-center gap-1">
              <span class="text-zinc-600">FRAME:</span>
              <span class="text-[#00ff88] font-bold" id="meta-index">01/08</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Fictional Critical Praise Panel (5 cols) -->
      <div class="lg:col-span-5 xl:col-span-4 flex flex-col justify-between bg-[#0c0e14] border border-zinc-700/80 p-5 sm:p-6 relative overflow-hidden group/praise">
        <!-- Top Edge Metallic Sheen Line with Purple and Green -->
