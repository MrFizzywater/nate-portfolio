    // Sam Morril
    {
      quote: "I'm not saying I'm bad under pressure, but if you ask me for my phone number while people are waiting behind me in line, I will guess.",
      author: "Sam Morril",
      title: "Same Time Tomorrow",
      outlet: "Netflix Comedy Special"
    },
    {
      quote: "I love New York because nobody cares what you're doing unless you're walking too slow on the sidewalk. Then it's a municipal emergency.",
      author: "Sam Morril",
      title: "I Got This",
