        <!-- Precision Corner Crosshairs in Neon Green and Purple -->
        <div class="absolute top-2 left-2 text-[10px] font-mono text-[#00ff88]/60 leading-none pointer-events-none">+</div>
        <div class="absolute top-2 right-2 text-[10px] font-mono text-[#c084fc]/60 leading-none pointer-events-none">+</div>
        <div class="absolute bottom-2 left-2 text-[10px] font-mono text-[#c084fc]/60 leading-none pointer-events-none">+</div>
        <div class="absolute bottom-2 right-2 text-[10px] font-mono text-[#00ff88]/60 leading-none pointer-events-none">+</div>

        <!-- Header of Praise Box -->
        <div>
          <div class="flex items-center justify-between border-b border-zinc-800/80 pb-3 mb-3">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-purple-500 transform rotate-45 inline-block"></span>
              <span class="text-[10px] font-mono uppercase tracking-[0.22em] text-purple-300">Curatorial Praise</span>
            </div>
            <button
              type="button"
              id="btn-shuffle-praise"
              class="text-[10px] font-mono text-zinc-400 hover:text-[#00ff88] transition-colors uppercase tracking-wider cursor-pointer flex items-center gap-1 px-2.5 py-1 bg-zinc-900 border border-zinc-800 hover:border-[#00ff88]"
              title="Generate alternative fictional review"
              data-flavor="CURATORIAL DISPATCH // Generate alternative scholarly critique from international art panel"
            >
              <span>Alt Review</span>
              <span class="text-[#00ff88]">↻</span>
            </button>
          </div>

          <!-- Dynamic Quote Block -->
          <div class="relative py-2 min-h-[140px] flex flex-col justify-center">
            <span class="text-3xl font-serif text-purple-500/40 leading-none select-none -mb-3 block font-bold">“</span>
            <blockquote 
              id="praise-quote" 
              class="text-sm sm:text-base font-light text-zinc-200 leading-relaxed italic transition-opacity duration-300"
            >
              Loading review...
            </blockquote>
          </div>
        </div>

        <!-- Critic Attribution -->
        <div class="border-t border-zinc-800/80 pt-4 mt-4 space-y-1">
          <div class="flex items-baseline justify-between gap-2">
            <h4 id="praise-author" class="text-xs font-mono font-medium text-white tracking-wide uppercase">
              Critic Name
            </h4>
            <span class="text-[9px] font-mono text-[#00ff88] uppercase tracking-widest shrink-0 font-semibold">
              Verified Critique
            </span>
          </div>
          <p id="praise-title" class="text-[11px] text-zinc-400 font-light leading-snug">
            Senior Adjunct of Atmospheric Dramaturgy
          </p>
          <p id="praise-outlet" class="text-[10px] font-mono text-purple-300/80 uppercase tracking-wider">
            The Brussels Monocle
          </p>
        </div>
      </div>

    </div>

    <!-- Filmstrip Preview Rack of Random Thumbnails -->
    <div class="mt-4 pt-3 border-t border-zinc-800/60">
      <div class="flex items-center justify-between mb-2">
        <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-zinc-400">Quick Swap Rack (Random Samples)</span>
        <span class="text-[10px] font-mono text-purple-400">Click to focus</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-2" id="thumbnail-rack">
        <!-- Injected via JavaScript -->
      </div>
    </div>
  </div>

  <!-- High-Res Inspection Modal Dialog -->
  <dialog 
    id="aperture-lightbox-modal"
    class="m-auto p-0 rounded-none backdrop:bg-black/90 bg-zinc-950 text-zinc-100 max-w-6xl w-[95vw] max-h-[92vh] overflow-hidden shadow-2xl border border-zinc-700"
  >
    <div class="relative bg-zinc-950 flex flex-col">
      <div class="flex items-center justify-between px-5 py-3.5 bg-zinc-900 border-b border-zinc-800">
        <div class="flex items-center gap-3">
          <span class="w-2 h-2 bg-[#00ff88] transform rotate-45 inline-block"></span>
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-200" id="modal-title">Frame Inspection</span>
        </div>
        <button 
          type="button"
          id="btn-close-modal"
          class="text-zinc-400 hover:text-[#00ff88] text-2xl font-light leading-none cursor-pointer px-2 transition-colors"
          aria-label="Close"
        >
          &times;
        </button>
      </div>

      <div class="aspect-video w-full bg-black flex items-center justify-center p-4">
        <img 
          id="modal-img" 
          src="" 
          alt="High Resolution Inspection"
          class="max-h-[75vh] w-auto max-w-full object-contain mx-auto" 
        />
      </div>

      <div class="px-5 py-3 bg-zinc-900/80 border-t border-zinc-800 flex items-center justify-between text-xs font-mono text-zinc-400">
        <span id="modal-meta" class="text-purple-300">35mm Atmospheric Study</span>
        <span class="text-[10px] uppercase tracking-widest text-zinc-400">Nate Lacroix Portfolio Archive</span>
      </div>
    </div>
  </dialog>
</div>

<script>
  interface PhotoData {
    id: string;
    title: string;
    year: number;
    image: string;
    category: string;
    description?: string;
  }

  interface PraiseItem {
    quote: string;
    author: string;
    title: string;
    outlet: string;
    category?: string;
  }

  const praises: PraiseItem[] = [
