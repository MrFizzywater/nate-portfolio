      <div class="px-5 py-3 bg-zinc-900/80 border-t border-zinc-800 flex items-center justify-between text-xs font-mono text-zinc-400">
        <span id="modal-meta" class="text-purple-300">35mm Atmospheric Study</span>
        <span class="text-[10px] uppercase tracking-widest text-zinc-400">Nate Lacroix Portfolio Archive</span>
      </div>
    </div>
  </dialog>
</div>

<script>
