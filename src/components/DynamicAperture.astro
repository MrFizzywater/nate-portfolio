      outlet: "The Gilded Shutter Review"
    },
    {
      quote: "Few living artists have captured the metaphysical ache of chain-link fencing with such terrifying, razor-sharp sincerity.",
      author: "Persephone Blight-Holloway",
      title: "Senior Fellow in Intentional Awkwardness",
      outlet: "The Royal Society of Spatial Tension"
    },
    {
      quote: "The foliage appears fully aware that winter is approaching and is quietly, deeply resentful of the entire meteorological process.",
      author: "Eustace C. Finch",
      title: "Chief Editor of Deciduous Grievances",
