  function initDynamicAperture() {
    const container = document.getElementById('dynamic-aperture-container');
    if (!container) return;

    const rawData = container.getAttribute('data-photos');
    if (!rawData) return;

    let photos: PhotoData[] = [];
    try {
      photos = JSON.parse(rawData);
    } catch {
      return;
    }

    // Exclude 'posters' gallery from the randomized frame engine
    photos = photos.filter((p) => {
      const cat = (p.category || '').toLowerCase().trim();
      const img = (p.image || '').toLowerCase();
      const id = (p.id || '').toLowerCase();
      return cat !== 'posters' && cat !== 'poster' && !img.includes('/posters/') && !id.startsWith('posters-');
    });

    if (photos.length === 0) return;

    // Elements
    const mainImg = document.getElementById('aperture-main-img') as HTMLImageElement | null;
    const ambientBackdrop = document.getElementById('ambient-backdrop');
    const shutterFlash = document.getElementById('shutter-flash');
    const metaTitle = document.getElementById('meta-title');
    const metaCategory = document.getElementById('meta-category');
    const metaYear = document.getElementById('meta-year');
    const metaLens = document.getElementById('meta-lens');
    const metaIndex = document.getElementById('meta-index');
    const thumbnailRack = document.getElementById('thumbnail-rack');
    const btnShuffle = document.getElementById('btn-shuffle-frame');
    const btnToggleCycle = document.getElementById('btn-toggle-cycle');
    const cycleLabel = document.getElementById('cycle-toggle-label');
    const cycleDot = document.getElementById('cycle-indicator-dot');
    const cycleProgressBar = document.getElementById('cycle-progress-bar');
    const btnEnlarge = document.getElementById('btn-enlarge-aperture');
    const modal = document.getElementById('aperture-lightbox-modal') as HTMLDialogElement | null;
    const modalImg = document.getElementById('modal-img') as HTMLImageElement | null;
    const modalTitle = document.getElementById('modal-title');
    const modalMeta = document.getElementById('modal-meta');
    const btnCloseModal = document.getElementById('btn-close-modal');

    // Stand-Up Comedy Elements
    const jokeQuote = document.getElementById('joke-quote') || document.getElementById('praise-quote');
    const jokeAuthor = document.getElementById('joke-author') || document.getElementById('praise-author');
    const jokeTitle = document.getElementById('joke-title') || document.getElementById('praise-title');
    const jokeOutlet = document.getElementById('joke-outlet') || document.getElementById('praise-outlet');
    const btnShuffleJoke = document.getElementById('btn-shuffle-joke') || document.getElementById('btn-shuffle-praise');

    // Simulated optical lenses for artistic cinematography telemetry
    const lenses = [
      '35mm ƒ/2.0',
      '50mm ƒ/1.4',
      '85mm ƒ/1.8',
      '24mm ƒ/2.8',
      '70-200mm ƒ/4.0',
      '40mm Anamorphic 2x',
      '28mm ƒ/2.8',
    ];

    let currentIndex = Math.floor(Math.random() * photos.length);
    let currentJokeIndex = -1;
    let isAutoCycling = false;
    let cycleTimer: any = null;
    let cycleProgressTimer: any = null;
    const CYCLE_DURATION = 4000; // ms

    function pickJoke(): JokeItem {
      if (jokes.length === 0) {
        return {
          quote: "I haven't slept for ten days, because that would be too long.",
          author: "Mitch Hedberg",
          title: "Mitch All Together",
          outlet: "Stand-Up Comedy"
        };
      }
      if (jokes.length === 1) return jokes[0];

      let nextJokeIdx = Math.floor(Math.random() * jokes.length);
      let attempts = 0;
      while (nextJokeIdx === currentJokeIndex && attempts < 10) {
        nextJokeIdx = Math.floor(Math.random() * jokes.length);
        attempts++;
      }
      currentJokeIndex = nextJokeIdx;
      return jokes[currentJokeIndex];
    }

    function updateJoke(animate = true) {
      const joke = pickJoke();
      if (!jokeQuote) return;

      if (animate) {
        jokeQuote.style.opacity = '0';
        setTimeout(() => {
          applyJoke(joke);
          jokeQuote.style.opacity = '1';
        }, 150);
      } else {
        applyJoke(joke);
      }
    }

    function applyJoke(joke: JokeItem) {
      if (jokeQuote) jokeQuote.textContent = joke.quote;
      if (jokeAuthor) jokeAuthor.textContent = joke.author;
      if (jokeTitle) jokeTitle.textContent = `Bit: "${joke.title}"`;
      if (jokeOutlet) jokeOutlet.textContent = joke.outlet;
    }

    function displayPhoto(index: number, animate = true) {
      if (!photos[index]) return;
      currentIndex = index;
      const photo = photos[index];

      if (animate && shutterFlash) {
        shutterFlash.style.opacity = '0.9';
        setTimeout(() => {
          shutterFlash.style.opacity = '0';
        }, 150);
      }

      setTimeout(() => {
        if (mainImg) {
          mainImg.src = photo.image;
          mainImg.alt = photo.title;
        }
        if (ambientBackdrop) {
          ambientBackdrop.style.backgroundImage = `url('${photo.image}')`;
        }
        if (metaTitle) metaTitle.textContent = photo.title;
        if (metaCategory) metaCategory.textContent = photo.category;
        if (metaYear) metaYear.textContent = String(photo.year);
        if (metaLens) {
          const lens = lenses[index % lenses.length];
          metaLens.textContent = lens;
        }
        if (metaIndex) {
          const formattedCurrent = String(index + 1).padStart(2, '0');
          const formattedTotal = String(photos.length).padStart(2, '0');
          metaIndex.textContent = `${formattedCurrent}/${formattedTotal}`;
        }

        // Update stand-up comedy joke
        updateJoke(animate);

        // Highlight active rack item with neon green
        updateActiveThumbnail(index);
      }, animate ? 100 : 0);
    }

    function renderThumbnailRack() {
      if (!thumbnailRack) return;
      thumbnailRack.innerHTML = '';

      const rackIndices = [currentIndex];
      const availableIndices = Array.from({ length: photos.length }, (_, i) => i).filter(i => i !== currentIndex);
      availableIndices.sort(() => 0.5 - Math.random());
      
      const countToTake = Math.min(photos.length, 6);
      while (rackIndices.length < countToTake && availableIndices.length > 0) {
        rackIndices.push(availableIndices.pop()!);
      }

      rackIndices.forEach((photoIdx) => {
        const item = photos[photoIdx];
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.dataset.index = String(photoIdx);
        btn.setAttribute('data-flavor', `APERTURE SWAP // Mount "${item.title}" into the dynamic active viewfinder`);
        btn.className = `group relative aspect-video bg-zinc-950 border overflow-hidden cursor-pointer transition-all duration-200 text-left ${
          photoIdx === currentIndex 
            ? 'border-[#00ff88] ring-1 ring-[#00ff88]' 
            : 'border-zinc-800 hover:border-purple-400'
        }`;

        btn.innerHTML = `
          <img src="${item.image}" alt="${item.title}" class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" loading="lazy" />
          <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors"></div>
          <span class="absolute bottom-1 left-1.5 right-1.5 text-[9px] font-mono text-zinc-300 truncate uppercase bg-black/80 px-1 py-0.5 border border-zinc-800/80">
            ${item.title}
          </span>
        `;

        btn.addEventListener('click', () => {
          displayPhoto(photoIdx, true);
          if (isAutoCycling) restartAutoCycleProgress();
        });

        thumbnailRack.appendChild(btn);
      });
    }

    function updateActiveThumbnail(activeIdx: number) {
      if (!thumbnailRack) return;
      thumbnailRack.querySelectorAll('button').forEach((btn) => {
        const idx = Number(btn.getAttribute('data-index'));
        if (idx === activeIdx) {
          btn.classList.add('border-[#00ff88]', 'ring-1', 'ring-[#00ff88]');
          btn.classList.remove('border-zinc-800', 'hover:border-purple-400');
        } else {
          btn.classList.remove('border-[#00ff88]', 'ring-1', 'ring-[#00ff88]');
          btn.classList.add('border-zinc-800', 'hover:border-purple-400');
        }
      });
    }

    function shuffleRandom() {
      let nextIndex = Math.floor(Math.random() * photos.length);
      if (photos.length > 1 && nextIndex === currentIndex) {
        nextIndex = (currentIndex + 1) % photos.length;
      }
      displayPhoto(nextIndex, true);
      renderThumbnailRack();
      if (isAutoCycling) restartAutoCycleProgress();
    }

    function startAutoCycle() {
      isAutoCycling = true;
      if (cycleLabel) cycleLabel.textContent = 'Auto-Cycle: Active';
      if (cycleDot) {
        cycleDot.classList.remove('bg-zinc-500');
        cycleDot.classList.add('bg-[#00ff88]');
      }
      restartAutoCycleProgress();
    }

    function stopAutoCycle() {
      isAutoCycling = false;
      if (cycleTimer) clearInterval(cycleTimer);
      if (cycleProgressTimer) clearInterval(cycleProgressTimer);
      if (cycleProgressBar) cycleProgressBar.style.width = '0%';
      if (cycleLabel) cycleLabel.textContent = 'Auto-Cycle: Off';
      if (cycleDot) {
        cycleDot.classList.remove('bg-[#00ff88]');
        cycleDot.classList.add('bg-zinc-500');
      }
    }

    function restartAutoCycleProgress() {
      if (!isAutoCycling) return;
      if (cycleTimer) clearInterval(cycleTimer);
      if (cycleProgressTimer) clearInterval(cycleProgressTimer);

      let start = Date.now();
      if (cycleProgressBar) cycleProgressBar.style.width = '0%';

      cycleProgressTimer = setInterval(() => {
        const elapsed = Date.now() - start;
        const pct = Math.min(100, (elapsed / CYCLE_DURATION) * 100);
        if (cycleProgressBar) cycleProgressBar.style.width = `${pct}%`;
      }, 50);

      cycleTimer = setTimeout(() => {
        shuffleRandom();
        restartAutoCycleProgress();
      }, CYCLE_DURATION);
    }

    function openModal() {
      if (!modal || !modalImg || !photos[currentIndex]) return;
      const cur = photos[currentIndex];
      modalImg.src = cur.image;
      if (modalTitle) modalTitle.textContent = `${cur.title} (${cur.year}) — ${cur.category}`;
      if (modalMeta) modalMeta.textContent = cur.description || `${cur.title} — Photography Archive`;
      modal.showModal();
    }

    // Event listeners
    btnShuffle?.addEventListener('click', () => shuffleRandom());

    btnToggleCycle?.addEventListener('click', () => {
      if (isAutoCycling) {
        stopAutoCycle();
      } else {
        startAutoCycle();
      }
    });

    const shuffleJokeBtn = btnShuffleJoke || document.getElementById('btn-shuffle-praise');
    shuffleJokeBtn?.addEventListener('click', () => {
      updateJoke(true);
    });

    btnEnlarge?.addEventListener('click', openModal);
    mainImg?.addEventListener('click', openModal);

    btnCloseModal?.addEventListener('click', () => modal?.close());
    modal?.addEventListener('click', (e) => {
      const rect = modal.getBoundingClientRect();
      const inBox = (
        rect.top <= e.clientY &&
        e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX &&
        e.clientX <= rect.left + rect.width
      );
      if (!inBox) modal.close();
    });

    // Initialize display with a random photo & stand-up comedy joke
    displayPhoto(currentIndex, false);
    renderThumbnailRack();
  }

  // Run on first load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDynamicAperture);
  } else {
    initDynamicAperture();
  }
</script>
