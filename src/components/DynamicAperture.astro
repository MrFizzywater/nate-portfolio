      category: "Atmosphere"
    },
    {
      quote: "The framing possesses the emotional gravity of a diesel semi-trailer idling in an empty gravel lot on a drizzly Sunday afternoon.",
      author: "Archibald Sterling-Greene",
      title: "Consultant to the Ministry of Dramatic Industrial Rust",
      outlet: "Edinburgh Cine-Texture Gazette",
