  const jokes: JokeItem[] = [
    // Pete Holmes
    {
      quote: "I don't think anyone is really an atheist. I think people are just mad at church. Because God didn't make waking up early on Sunday in stiff pants a requirement—some guy named Gary did.",
      author: "Pete Holmes",
