            id="ambient-backdrop" 
            class="absolute inset-0 bg-cover bg-center blur-2xl opacity-25 scale-110 transition-all duration-700 pointer-events-none"
          ></div>

          <!-- Main Display Image -->
          <img 
            id="aperture-main-img" 
            src="" 
            alt="Random Gallery Frame" 
            class="relative max-h-full max-w-full object-contain z-10 transition-all duration-500 ease-out cursor-zoom-in"
